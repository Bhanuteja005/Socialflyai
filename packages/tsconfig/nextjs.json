{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"jsx": "preserve",
		"allowJs": false,
		"incremental": true,
		"allowImportingTsExtensions": false,
		"noUnusedParameters": false,
		"plugins": [{ "name": "next" }]
	}
}
