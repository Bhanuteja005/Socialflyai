# Copy to infra/jenkins/.env (git-ignored) and fill in. Read by compose.yaml and
# substituted into casc.yaml. See docs/ci-jenkins.md for what each one does.

# ── controller ────────────────────────────────────────────────────────────────
JENKINS_ADMIN_ID=admin
# Required. Generate one: openssl rand -base64 24
JENKINS_ADMIN_PASSWORD=
# Public URL of this controller (used in GitHub status links and webhooks).
JENKINS_URL=http://localhost:4780/
# Linux hosts: the docker socket's group id (stat -c %g /var/run/docker.sock).
# Docker Desktop: leave unset.
# DOCKER_GID=
JENKINS_EXECUTORS=4

# ── GitHub (secret) ───────────────────────────────────────────────────────────
# Fine-grained PAT for Bhanuteja005/Socialflyai: Contents read, Metadata read,
# Pull requests read, Commit statuses read/write.
GITHUB_USERNAME=Bhanuteja005
GITHUB_TOKEN=

# ── deployment (non-secret) ───────────────────────────────────────────────────
# Leave AZURE_ACR_NAME empty to run CI only (nothing is built or deployed).
AZURE_ACR_NAME=
AZURE_RESOURCE_GROUP=
ACA_AUTH_APP=
ACA_API_APP=
ACA_WORKER_APP=
# Container App serving apps/app (the dashboard, image socialfly/app).
ACA_WEB_APP=
# Container App serving apps/site (marketing, image socialfly/site).
ACA_SITE_APP=
# Container App serving apps/admin (image socialfly/admin); required once apps/admin exists.
ACA_ADMIN_APP=
ACA_MIGRATE_JOB=
AUTH_URL=
API_URL=
# Dashboard (apps/app) public URL.
WEB_URL=
# Marketing site (apps/site) public URL.
SITE_URL=
ADMIN_URL=
NEXT_PUBLIC_SENTRY_DSN=
# Comma-separated Jenkins user ids who must approve each production deploy. Blank = no approval step.
DEPLOY_APPROVERS=
FORK_PR_APPROVERS=admin
