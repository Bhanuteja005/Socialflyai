# ─────────────────────────────────────────────────────────────────────────────
# SocialFly — local environment. ONE file for every backend service.
#
#   bun run cli env      copies this to .env with freshly generated secrets
#
# Rules:
#   • .env is gitignored. Never commit real values (CI runs gitleaks on every push).
#   • Every value below has a working local default in packages/config, so an
#     almost-empty .env runs locally. In PRODUCTION the services refuse to boot
#     without real values for secrets (see packages/config/src/shared.ts).
#   • Frontend NEXT_PUBLIC_* live in apps/{app,site}/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Data stores (infra/compose — `bun run cli stack up`) ─────────────────────
DATABASE_URL=postgres://socialfly:socialfly@localhost:5434/socialfly
REDIS_URL=redis://localhost:6380

# ── Auth (apps/auth mints tokens; api + worker verify them) ──────────────────
AUTH_ISSUER=http://localhost:4800
AUTH_AUDIENCE=socialfly-services
# ≥32 chars. `bun run cli env` / `bun run cli secrets` generate one.
AUTH_JWT_SECRET=
# Parent domain for cookies in production (e.g. .socialfly.ai); "localhost" locally.
AUTH_COOKIE_DOMAIN=localhost
# "Sign in with Google" (optional locally). Redirect: http://localhost:4800/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Encryption of platform OAuth tokens at rest (32 bytes, base64) ───────────
TOKEN_ENCRYPTION_KEY=
# During a key rotation only: the previous key, still accepted for decryption.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── URLs ─────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:4700
API_URL=http://localhost:4400
# Public marketing site and internal admin console.
SITE_URL=http://localhost:4701
ADMIN_URL=http://localhost:4702
# Browser origins allowed to call auth + api: the product app and the admin console.
CORS_ORIGINS=http://localhost:4700,http://localhost:4702

# ── Object storage (S3 API: RustFS locally, Cloudflare R2 in production) ─────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=socialfly-media
S3_ACCESS_KEY_ID=socialfly
S3_SECRET_ACCESS_KEY=socialfly-dev-secret
# Must be reachable by Instagram/Threads/Facebook servers when publishing media
# for real (use a tunnel such as `cloudflared` locally).
S3_PUBLIC_URL=http://localhost:9000/socialfly-media

# ── Mail (Mailpit locally — inbox at http://localhost:8025) ──────────────────
SMTP_URL=smtp://localhost:1025
MAIL_FROM=SocialFly <no-reply@socialfly.local>

# ── Social platform apps (empty = platform hidden in the UI) ─────────────────
# OAuth redirect URI to register with each platform:
#   {API_URL}/channels/callback/{provider}   e.g. http://localhost:4400/channels/callback/linkedin
# See docs/platforms.md for the app setup and review steps per platform.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509
# One Meta app serves both Facebook Pages and Instagram.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
THREADS_APP_ID=
THREADS_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:socialfly:v1.0 (by /u/your_reddit_username)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── AI content (empty key = that feature hidden in the UI) ───────────────────
# Text: posts, rewrites, hashtags, carousel outlines (Anthropic Claude).
ANTHROPIC_API_KEY=
AI_TEXT_MODEL=claude-opus-5
AI_TEXT_EFFORT=medium
# Images: tried in order — OpenAI first, then Gemini.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Voiceover for AI videos (same key).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Research: AI-visibility checks also use Perplexity (optional); SEO data via DataForSEO (optional).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# AI-visibility: model asked per assistant (each runs only when its key above is set).
VISIBILITY_CLAUDE_MODEL=claude-opus-5
VISIBILITY_OPENAI_MODEL=gpt-6-astra
VISIBILITY_GEMINI_MODEL=gemini-3.8-flash
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Website crawl for brand research: max pages per crawl.
RESEARCH_MAX_PAGES=40
# Monthly AI spend cap per organization in USD (0 = unlimited).
AI_ORG_MONTHLY_BUDGET_USD=25

# ── Worker ───────────────────────────────────────────────────────────────────
# Comma list of queues this process consumes; empty = all.
WORKER_QUEUES=
PUBLISH_CONCURRENCY=5
AI_MEDIA_CONCURRENCY=2
BULL_BOARD_ENABLED=true

# ── Observability ────────────────────────────────────────────────────────────
# Local: `bun run cli stack up observability` → Grafana at http://localhost:4703
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
